APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Host the JSON API answers on at its root in production (no "/api" prefix),
# e.g. api.fondeks.com. Leave empty locally — the API is reached under /api.
API_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── Ingest: market data ─────────────────────────────────────────────────────
# "fixture" (offline) or "tefas" (live import).
MARKET_DATA_PROVIDER=fixture
TEFAS_BASE_URL="https://www.tefas.gov.tr/api/funds"
TEFAS_TIMEOUT_MS=90000
TEFAS_MAX_RETRIES=3
TEFAS_CONCURRENCY=3
TEFAS_RATE_LIMIT=8
TEFAS_RATE_WINDOW_MS=60000
TEFAS_FUND_TYPES="YAT,EMK,BYF"
# INGEST_LOG_SAMPLES=false

# ── Ingest: market indices ──────────────────────────────────────────────────
TCMB_BASE_URL="https://www.tcmb.gov.tr/kurlar"
TCMB_EVDS_API_KEY=""
EVDS_BASE_URL="https://evds3.tcmb.gov.tr/igmevdsms-dis"
# EVDS_SERIES=""

# ── Ingest: fund holdings (KAP) ─────────────────────────────────────────────
# "fixture" (offline) or "kap" to read real filings (needs ANTHROPIC_API_KEY).
HOLDINGS_PROVIDER=fixture
KAP_BASE_URL="https://www.kap.org.tr"
KAP_TIMEOUT_MS=25000
KAP_CONCURRENCY=3
# KAP IP-blocks fast callers; keep this gentle. ~30 req/min on one worker.
KAP_RATE_LIMIT=30
KAP_RATE_WINDOW_MS=60000
KAP_SUBMIT_LIMIT=200
KAP_DOCUMENT_LIMIT=500
KAP_DISCLOSURE_LIMIT=500
KAP_DISCLOSURE_DAYS=7
KAP_EXTRACT_BATCH_SIZE=200
KAP_INCEPTION_LIMIT=200
KAP_DIRECTORY_TIMEOUT_MS=90000

ANTHROPIC_API_KEY=""
ANTHROPIC_MAX_RETRIES=3
